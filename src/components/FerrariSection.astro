---
import { Card } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
---

<!-- FERRARI SECTION -->
<section class="w-full border-b border-outline-variant bg-surface-container-lowest scroll-mt-16" id="ferrari">
  <div class="w-full max-w-[1600px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin py-space-xl">
    <!-- Section Header -->
    <div class="mb-space-lg">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 bg-[#D40000]"></span>
        <span class="font-label-mono-sm text-label-mono-sm text-[#D40000] uppercase tracking-widest">
          CHAPTER 02 // SCUDERIA MOTORSPORT LINEAGE
        </span>
      </div>
      <h2 class="font-headline-xl text-headline-xl uppercase text-primary tracking-tight mt-1">
        FERRARI
      </h2>
      <div class="w-full h-px bg-[#D40000] mt-3 mb-4"></div>
      <div class="flex flex-wrap items-center justify-between text-outline font-label-mono-sm text-label-mono-sm uppercase tracking-wider gap-2">
        <span>Maranello, Italy</span>
        <span>Founded 1947</span>
        <span>Philosophy: Formula 1 Supremacy Transferred to Road</span>
      </div>
    </div>

    <!-- Hero Photograph -->
    <div class="w-full border border-outline-variant relative bg-surface-container-low overflow-hidden mb-space-xl">
      <div class="relative w-full h-[440px] md:h-[680px]">
        <img
          alt="Ferrari F80 hypercar on high-speed circuit in late dusk"
          class="w-full h-full object-cover"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuDDJQn6qg9X5IQL3zrJiPr_vlqP2hG2JXnOQxQ8M0mCN1KuHDkLEP9wYfbrbYJpXYOtmEv9cHD2Pa-8weY2BVXcR9U7zJUEmtO5ZZZdwRB7AgsQ-4L6uHqsERy-ihwBb7C8lVWhJqEzwfEkPlILzUuZFbzgbTMBwGYuJiiyzysPKWCiEfg8ZG43hfUl6B_Cjau-YEIdmxlKgJENkqtzqDRRn_FDILLROdZ9L4GZQY2Vl4qUhCd7uVU8CJpJOQXWH3ViNzqzbkwXZlgVDA"
        />
        <div class="absolute bottom-0 left-0 right-0 p-4 md:p-6 bg-surface-container-lowest/90 border-t border-outline-variant flex flex-col md:flex-row md:items-center justify-between gap-2">
          <span class="font-label-mono-sm text-label-mono-sm text-primary uppercase">
            Plate F-01: Ferrari F80 Halo Hypercar // Aerodynamic Testing // Fiorano Circuit
          </span>
          <span class="font-label-mono-sm text-label-mono-sm text-outline">
            SHUTTER: 1/1000s // F/2.8 // ISO 320 // 70MM
          </span>
        </div>
      </div>
    </div>

    <!-- Inverted Layout: Archival & Timeline on Left, Origin Copy on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter mb-space-xl">
      <!-- Archival Image + Timeline Split (Left Column) -->
      <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-gutter order-2 lg:order-1">
        <!-- Archival Image Card -->
        <Card className="bg-surface flex flex-col rounded-none">
          <div class="p-2 border-b border-outline-variant font-label-mono-sm text-label-mono-sm text-outline uppercase">
            ARCHIVE REF: MARANELLO 1947
          </div>
          <div class="h-64 sm:h-72 overflow-hidden">
            <img
              alt="1947 Ferrari 125 S prototype sports racer"
              class="w-full h-full object-cover grayscale contrast-125"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAXpudaZC_ib8vLyJwDBFetNDCqMqqw-GZaAViq1VST96PhjY9bEuxdENi0aruFiQjSDawDvVPwJ0vvhbQ5uoSyC-0fnVUJNliFQY4w84ZSqHCq-4_YuQkTip_44sG_k2277UJT8ad1KVF-O3dfZEjUslSETWqzJLxjeC4v276HBuA9A1yrv8XYDE2mKgTYQ4IABDxjlTJQnKq1Wr_yHQNCV3rHveHcEsSfk4Yw3E4prKVkjHt47LkQ"
            />
          </div>
          <div class="p-4 border-t border-outline-variant bg-surface-container-lowest flex-1">
            <p class="font-body-sm text-body-sm text-on-surface">Ferrari 125 S outside Maranello factory gates, 1947.</p>
            <p class="font-label-mono-sm text-label-mono-sm text-outline mt-2 uppercase">
              1.5L Gioachino Colombo-designed 60-degree V12 engine.
            </p>
          </div>
        </Card>

        <!-- Vertical Timeline Card -->
        <Card className="bg-surface p-6 flex flex-col justify-between rounded-none">
          <div>
            <div class="font-label-mono-sm text-label-mono-sm text-outline uppercase tracking-wider pb-3 border-b border-outline-variant mb-4">
              HISTORICAL LINEAGE // SCUDERIA CANON
            </div>
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <span class="font-label-mono-md text-label-mono-md text-[#D40000] font-mono shrink-0">1929</span>
                <div>
                  <h4 class="font-body-sm font-semibold text-primary">Scuderia Ferrari</h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Founded in Modena as independent racing stable running Alfa Romeos.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="font-label-mono-md text-label-mono-md text-[#D40000] font-mono shrink-0">1947</span>
                <div>
                  <h4 class="font-body-sm font-semibold text-primary">Ferrari 125 S</h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">First car constructed under Ferrari name debuts at Piacenza circuit.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="font-label-mono-md text-label-mono-md text-[#D40000] font-mono shrink-0">1950</span>
                <div>
                  <h4 class="font-body-sm font-semibold text-primary">Formula 1 Debut</h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Competes in the inaugural Formula 1 championship season in Monaco.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="font-label-mono-md text-label-mono-md text-[#D40000] font-mono shrink-0">1984</span>
                <div>
                  <h4 class="font-body-sm font-semibold text-primary">288 GTO Halo</h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Twin-turbocharged V8 begins modern series of flagship hypercars.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="pt-4 border-t border-outline-variant font-label-mono-sm text-label-mono-sm text-outline mt-6">
            SCUDERIA CONTINUOUS F1 COMPETITION // 75 YEARS
          </div>
        </Card>
      </div>

      <!-- Origin Copy (Right Column) -->
      <div class="lg:col-span-5 border-l-0 lg:border-l border-outline-variant pl-0 lg:pl-gutter flex flex-col justify-between order-1 lg:order-2">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2 h-2 bg-[#D40000]"></span>
            <span class="font-label-mono-sm text-label-mono-sm uppercase text-outline tracking-wider">MARANELLO DOCTRINE</span>
          </div>
          <h3 class="font-headline-md text-headline-md uppercase text-primary mb-4">
            The Primacy of the Scuderia
          </h3>
          <p class="font-body-md text-body-md text-on-surface-variant mb-6">
            Enzo Ferrari began as a racing driver and ran Alfa Romeo's racing team before founding Scuderia Ferrari in 1929. The first car to wear the Ferrari name, the 125 S, was built in Maranello in 1947. Road cars exist to fund the racing program, which is why the racing team still defines the brand.
          </p>
          <div class="p-4 bg-surface border border-outline-variant">
            <span class="font-label-mono-sm text-label-mono-sm text-[#D40000] uppercase block mb-1">
              ARCHIVIST NOTE // REF #MAR-125S
            </span>
            <p class="font-body-sm text-body-sm text-secondary">
              Enzo Ferrari once declared that when a customer purchases a Ferrari, they are paying for the engine; the rest of the car is thrown in for free.
            </p>
          </div>
        </div>
        <div class="pt-6 mt-6 border-t border-outline-variant">
          <p class="font-headline-lg text-headline-lg text-[#D40000] uppercase tracking-tight">"Racing is in our blood."</p>
          <span class="font-label-mono-sm text-label-mono-sm text-outline uppercase tracking-wider block mt-1">
            Enzo Ferrari // The Founding Principle
          </span>
        </div>
      </div>
    </div>

    <!-- Flagship Spec Table -->
    <div class="border border-outline-variant bg-surface p-6 md:p-8 mb-space-xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
        <div class="lg:col-span-5">
          <span class="font-label-mono-sm text-label-mono-sm text-[#D40000] uppercase tracking-wider block mb-1">
            FLAGSHIP TECHNICAL DOSSIER
          </span>
          <h3 class="font-headline-xl text-headline-xl uppercase text-primary">F80</h3>
          <p class="font-body-md text-body-md text-on-surface-variant mt-4">
            Ferrari's hypercar flagship, a limited-run halo car that brings Formula 1 hybrid thinking to the road.
          </p>
          <div class="mt-6 font-label-mono-sm text-label-mono-sm text-outline space-y-1">
            <div>ASSEMBLY: OFFICINA SPECIALE, MARANELLO</div>
            <div>HOMOLOGATION: LIMITED SERIES PRODUCTION (799 UNITS)</div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>PARAMETER</TableHead>
                <TableHead className="text-right">MEASURED VALUE</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              <TableRow className="bg-surface-container-lowest hover:bg-surface-container">
                <TableCell className="font-body-sm text-on-surface">Engine</TableCell>
                <TableCell className="font-label-mono-md text-label-mono-md text-primary text-right font-mono">
                  3.0L V6 twin-turbo + 3 electric motors
                </TableCell>
              </TableRow>
              <TableRow className="bg-surface-container-lowest hover:bg-surface-container">
                <TableCell className="font-body-sm text-on-surface">Power</TableCell>
                <TableCell className="font-label-mono-md text-label-mono-md text-primary text-right font-mono">
                  1,184 hp
                </TableCell>
              </TableRow>
              <TableRow className="bg-surface-container-lowest hover:bg-surface-container">
                <TableCell className="font-body-sm text-on-surface">0-100 km/h</TableCell>
                <TableCell className="font-label-mono-md text-label-mono-md text-primary text-right font-mono">
                  2.15 s
                </TableCell>
              </TableRow>
              <TableRow className="bg-surface-container-lowest hover:bg-surface-container">
                <TableCell className="font-body-sm text-on-surface">Top speed</TableCell>
                <TableCell className="font-label-mono-md text-label-mono-md text-primary text-right font-mono">
                  350 km/h
                </TableCell>
              </TableRow>
              <TableRow className="bg-surface-container-lowest hover:bg-surface-container">
                <TableCell className="font-body-sm text-on-surface">Drive</TableCell>
                <TableCell className="font-label-mono-md text-label-mono-md text-primary text-right font-mono">
                  AWD
                </TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </div>
      </div>
    </div>

    <!-- Gallery Strip (3 In Row) -->
    <div>
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-outline-variant">
        <span class="font-label-mono-sm text-label-mono-sm text-outline uppercase tracking-wider">
          MECHANICAL PLATES // DETAIL INSPECTION
        </span>
        <span class="font-label-mono-sm text-label-mono-sm text-[#D40000] uppercase">
          3 ARCHIVAL APERTURES
        </span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        <Card className="bg-surface overflow-hidden group rounded-none">
          <div class="h-64 overflow-hidden relative">
            <img
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
              alt="Technical close-up studio shot of a 120-degree hot-V V6 twin-turbo Formula 1 hybrid engine block"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCSe4nSPirbqm-ouIw9WdXyLOwOcTdP3ksp-P6tE3k51wVGNG78hNEeuZckYuwGTeAtCNtv__FtkRe6279yRS5K6mydhA-EC-9pkLa2L2AvYjbr-KTrxjJiiKWIgU18OY10Ezzg1z8xww5k8UkUBwhR7Ihwt3yDvDL3xtYAKIZH_yu8INxYYT8PcRtZAvE9I8CDb4HPA2q5zi5gZTzUYK0peoHXqp0A1K4xrWNcI7GMd64LakjY5WR3"
            />
          </div>
          <div class="p-3 border-t border-outline-variant font-label-mono-sm text-label-mono-sm">
            <span class="text-primary block uppercase">PL-04 // 120° V6 HYBRID POWERTRAIN</span>
            <span class="text-outline">499P Le Mans winner internal combustion architecture.</span>
          </div>
        </Card>

        <Card className="bg-surface overflow-hidden group rounded-none">
          <div class="h-64 overflow-hidden relative">
            <img
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
              alt="Detailed view of a modern Ferrari halo car cockpit"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAvJz-LSVPJl0-NhomxWXDXnBdWEOB50gEZyx-bA9buFKx1nj1uXW7EebFndOy05qK1LYXyAIvWra7O3MqNShPy4Tjc9nSzQbSWTRA9b6lg7cRfffcI3qstESJXZeG4HQ7aeshpHzyFR1C5YsplFaCX5lER9mChhdUGmEcFAQwGxsxxnD1rY8vQxCSchPqRGg-caCP3jJUqwGWpt-mx6icbPjZu5YXc9u6_WmlJA-_oaU_QxtOs-AkW"
            />
          </div>
          <div class="p-3 border-t border-outline-variant font-label-mono-sm text-label-mono-sm">
            <span class="text-primary block uppercase">PL-05 // MONOPOSTO ERGONOMICS</span>
            <span class="text-outline">Formula 1 cockpit asymmetric tub orientation.</span>
          </div>
        </Card>

        <Card className="bg-surface overflow-hidden group rounded-none">
          <div class="h-64 overflow-hidden relative">
            <img
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
              alt="Action tracking shot of Ferrari F80 hypercar braking into apex at Fiorano circuit"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuD_oJgWCYYqSbR9i_AMlZJg5TWLOgoWHD-NNk0-pq4b3tcNiy2YeMsmejQdeu4pYyPHb8y25m6l5E7pfxIpjzAvTRcfV8ez4_Q6r-bVmCruiDmMppPSTZzx2_p57OH4slXBpH0HZ30NYE9iDn1P8C0zr8cvIJ9Ya9eRGP7hAzkDthXO1izMEU5wR8nbV-sKtmhALuuzvgZ29ORgeZWdmzbbLZ7CQLK8UjVVIKTDpdghSGfEo5MI3txo"
            />
          </div>
          <div class="p-3 border-t border-outline-variant font-label-mono-sm text-label-mono-sm">
            <span class="text-primary block uppercase">PL-06 // ACTIVE AERO ATTACK</span>
            <span class="text-outline">High-downforce dynamic DRS braking configuration.</span>
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>
