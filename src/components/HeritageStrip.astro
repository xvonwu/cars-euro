---
import { Card } from "@/components/ui/card";
---

<!-- FIRST HERITAGE STRIP (TRANSITION) -->
<section class="w-full border-b border-outline-variant bg-surface-container-lowest py-space-lg">
  <div class="w-full max-w-[1600px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin">
    <div class="flex items-center justify-between pb-3 border-b border-outline-variant mb-6">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 bg-primary"></span>
        <span class="font-label-mono-sm text-label-mono-sm uppercase text-primary tracking-widest">
          COMPARATIVE HISTORICAL LEDGER // 1948-1970
        </span>
      </div>
      <span class="font-label-mono-sm text-label-mono-sm text-outline uppercase font-mono">
        CANONICAL CHASSIS INDEX
      </span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
      <!-- 356 -->
      <Card className="bg-surface-container p-3 rounded-none hover:border-outline transition-colors">
        <div class="h-44 overflow-hidden mb-3 border border-outline-variant">
          <img
            alt="Porsche 356 Gmünd Coupe in Austria"
            class="w-full h-full object-cover grayscale contrast-125 hover:scale-105 transition-transform duration-500"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBcxPfZr-kx2ZVGMs9ohapPuYchaiJgm8gGxz6Tnf22xWPba85TOG27qq6-dgsKaXAc0F3nYN8hMusZWWKYbh43AQYXZXRBsEyn0rmQGTrn8rUEMArh6r3-jWO3fq6b_MBqsDCCJkw6kMEa2hJhgG0QkOh9G2UHT0KUZ0Q_npl0VOiVLhAvAQQGRUZj3HKzcbYpulZ78lIliEJZEV_8gXeqNd-ry3LOdGuTNN_GtXjZaqBkkWg9myPJ"
          />
        </div>
        <div class="font-label-mono-sm text-label-mono-sm flex justify-between items-center text-outline">
          <span class="text-primary uppercase font-semibold">PORSCHE 356</span>
          <span class="font-mono">1948</span>
        </div>
        <p class="font-caption-archival text-caption-archival text-secondary mt-1">
          Gmünd hand-beaten aluminum alloy shell.
        </p>
      </Card>

      <!-- Ferrari 250 GTO -->
      <Card className="bg-surface-container p-3 rounded-none hover:border-outline transition-colors">
        <div class="h-44 overflow-hidden mb-3 border border-outline-variant">
          <img
            alt="1962 Ferrari 250 GTO Berlinetta"
            class="w-full h-full object-cover grayscale contrast-125 hover:scale-105 transition-transform duration-500"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBXk-75JphbViXUj3OZHBsc2MwB1rHDgQOm34dGWlu3fyfj1jW6UhO5PymUuCq6aByGbKLomIR0RSQMALOAE7hie48cA7gkX7Z95JEAP2G3iaarnuHSGiRbCKaEsDIlVpyqWh3Wyr421l04Je3VqwXtiE67pIMQsJlrjCGgwFJZLNejSTcYF-PQhnIUItjn6kWOcI0_SQ0MzCawEFIMZ7DLQWtA5yBDjw9-4vhl1dKGIwU68DqXZdOC"
          />
        </div>
        <div class="font-label-mono-sm text-label-mono-sm flex justify-between items-center text-outline">
          <span class="text-primary uppercase font-semibold">FERRARI 250 GTO</span>
          <span class="font-mono">1962</span>
        </div>
        <p class="font-caption-archival text-caption-archival text-secondary mt-1">
          Colombo 3.0L dry-sump V12 grand tourer.
        </p>
      </Card>

      <!-- Lamborghini Miura -->
      <Card className="bg-surface-container p-3 rounded-none hover:border-outline transition-colors">
        <div class="h-44 overflow-hidden mb-3 border border-outline-variant">
          <img
            alt="1966 Lamborghini Miura P400"
            class="w-full h-full object-cover grayscale contrast-125 hover:scale-105 transition-transform duration-500"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuCfNyfC69U5urgjYfYRDQmZIPwZCqnPV-7FKWTdsXlCrRUaQtWaE3buOa-6kHx_RpiIRP9T2uvm_sazBmfIUTueied4ZZwO5_Aaoh9P0jnpRoYUjyECuKe6izvISm2jcSUVNZPOH94FgLpHs4lJ5yLfWwrxe7WFZ_RWQm1L4lLmqmmgP1lMfs6LVyuR-HRlzWzmLzM8WAefXAD3ZGPUaFDYTrgzKZjn3H_6m65onzzZ5B-0d4tOQhng"
          />
        </div>
        <div class="font-label-mono-sm text-label-mono-sm flex justify-between items-center text-outline">
          <span class="text-primary uppercase font-semibold">LAMBORGHINI MIURA</span>
          <span class="font-mono">1966</span>
        </div>
        <p class="font-caption-archival text-caption-archival text-secondary mt-1">
          Transverse mid-engine layout by Gandini.
        </p>
      </Card>

      <!-- Porsche 917 -->
      <Card className="bg-surface-container p-3 rounded-none hover:border-outline transition-colors">
        <div class="h-44 overflow-hidden mb-3 border border-outline-variant">
          <img
            alt="Porsche 917 short-tail race car at Le Mans"
            class="w-full h-full object-cover grayscale contrast-125 hover:scale-105 transition-transform duration-500"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDYBU7b1Z2DxFTfGLsk7tCedC2obNUI94054Q71ibyDNPeaXrma_oQOm82kgdCFl49SC0YTI1AS4bJsJd7mWkuSDm_b1XASb3MC28UEZ2a34b8BbGHySMgp6MCLqTBP6Sn3S6Zq6EKGIh2cu57U5NSsZk3T5dODV8Kfd0qqPOFRewn9q3TsHIsSc1DjXrCyWueC-ZkAJGFixdxqUViVnyX-DH5CvKNpAtA0fBr4DIefIG7HG46KxExo"
          />
        </div>
        <div class="font-label-mono-sm text-label-mono-sm flex justify-between items-center text-outline">
          <span class="text-primary uppercase font-semibold">PORSCHE 917</span>
          <span class="font-mono">1970</span>
        </div>
        <p class="font-caption-archival text-caption-archival text-secondary mt-1">
          Type 912 4.5L Flat-12 endurance prototype.
        </p>
      </Card>
    </div>
  </div>
</section>
