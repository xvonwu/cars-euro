---
import { Card } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
---

<!-- LAMBORGHINI SECTION -->
<section class="w-full border-b border-outline-variant bg-surface scroll-mt-16" id="lamborghini">
  <div class="w-full max-w-[1600px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin py-space-xl">
    <!-- Section Header -->
    <div class="mb-space-lg">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 bg-[#C7D500]"></span>
        <span class="font-label-mono-sm text-label-mono-sm text-[#C7D500] uppercase tracking-widest">
          CHAPTER 03 // BOLOGNESE RADICALISM
        </span>
      </div>
      <h2 class="font-headline-xl text-headline-xl uppercase text-primary tracking-tight mt-1">
        LAMBORGHINI
      </h2>
      <div class="w-full h-px bg-[#C7D500] mt-3 mb-4"></div>
      <div class="flex flex-wrap items-center justify-between text-outline font-label-mono-sm text-label-mono-sm uppercase tracking-wider gap-2">
        <span>Sant'Agata Bolognese, Italy</span>
        <span>Founded 1963</span>
        <span>Philosophy: Uncompromising Wedge Aesthetics &amp; Naturally Aspirated Theatrics</span>
      </div>
    </div>

    <!-- Hero Photograph -->
    <div class="w-full border border-outline-variant relative bg-surface-container-lowest overflow-hidden mb-space-xl">
      <div class="relative w-full h-[440px] md:h-[680px]">
        <img
          alt="Lamborghini Revuelto traversing dramatic wet Italian mountain pass"
          class="w-full h-full object-cover"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuD57vqxn1N7a_Tn5KUB8lNROR7-8LRIdYaXd3nNDNCVIZez3pBZ0wR_EmvWMq8M-4Ypx0Aq0lNUE09FosDV--UB8GJBWVX9XQepG7Z_A1P4qf5Eh593XzguEPGfNrflqfOP9qTpgrZ2JeNZNCu6nNXRGlJRJ0zhwWWiRwtGzB_C0AwocZgX8WZdh5tmdcnocf7QhElmKIiXqvbEyVv7v9aJ8ilmNQ5HX_KwojLYBjvhRQtzyw1oGl-LasfnVJXwRgGIkVz_1-6JZrLTGg"
        />
        <div class="absolute bottom-0 left-0 right-0 p-4 md:p-6 bg-surface-container-lowest/90 border-t border-outline-variant flex flex-col md:flex-row md:items-center justify-between gap-2">
          <span class="font-label-mono-sm text-label-mono-sm text-primary uppercase">
            Plate L-01: Lamborghini Revuelto HPEV // High Altitude Dynamic Run // Passo Sella
          </span>
          <span class="font-label-mono-sm text-label-mono-sm text-outline">
            SHUTTER: 1/640s // F/3.5 // ISO 250 // 50MM
          </span>
        </div>
      </div>
    </div>

    <!-- Origin & Archival Ledger -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter mb-space-xl">
      <!-- Origin Text -->
      <div class="lg:col-span-5 border-r-0 lg:border-r border-outline-variant pr-0 lg:pr-gutter flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2 h-2 bg-[#C7D500]"></span>
            <span class="font-label-mono-sm text-label-mono-sm uppercase text-outline tracking-wider">FOUNDING REBELLION</span>
          </div>
          <h3 class="font-headline-md text-headline-md uppercase text-primary mb-4">
            The Defiance of Ferruccio
          </h3>
          <p class="font-body-md text-body-md text-on-surface-variant mb-6">
            Ferruccio Lamborghini made his fortune building tractors, then decided to build grand touring cars of his own. He founded Automobili Lamborghini in 1963 and the first car, the 350 GT, followed in 1964. The Miura of 1966 put the engine behind the driver and set the template for the supercar.
          </p>
          <div class="p-4 bg-surface-container-low border border-outline-variant">
            <span class="font-label-mono-sm text-label-mono-sm text-[#C7D500] uppercase block mb-1">
              ARCHIVIST NOTE // REF #SAB-350GT
            </span>
            <p class="font-body-sm text-body-sm text-secondary">
              Following an argument with Enzo Ferrari regarding fragile clutches in his personal 250 GT, Ferruccio resolved to build a GT that suffered no thermal or mechanical compromises.
            </p>
          </div>
        </div>
        <div class="pt-6 mt-6 border-t border-outline-variant">
          <p class="font-headline-lg text-headline-lg text-[#C7D500] uppercase tracking-tight">"Performance with attitude."</p>
          <span class="font-label-mono-sm text-label-mono-sm text-outline uppercase tracking-wider block mt-1">
            Ferruccio Lamborghini // The Industrial Challenge
          </span>
        </div>
      </div>

      <!-- Archival Image + Timeline Split -->
      <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-gutter">
        <!-- Archival Image Card -->
        <Card className="bg-surface-container-low flex flex-col rounded-none">
          <div class="p-2 border-b border-outline-variant font-label-mono-sm text-label-mono-sm text-outline uppercase">
            ARCHIVE REF: SANT'AGATA 1964
          </div>
          <div class="h-64 sm:h-72 overflow-hidden">
            <img
              alt="Ferruccio Lamborghini with 350 GT prototype in Sant'Agata, 1964"
              class="w-full h-full object-cover grayscale contrast-125"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDCQYihjt0UefRay4qKk60kQJxvS6xXDfTTlVGHZ9kNgOJu90SWJRy823oILgQZJIz3kWlN4_dIyHkqBxZXldg7tNlLGcjFpQyFFZsBwjwcVnVxitQJ5WjZvtPTkQsRYk-skUWk8QNiRdT9XvO1wD1mK3U6tKwi3G_TDqaBDAqWWSaBFp9JnKRpJuWlQc5RjTzSHv6rIpDyh-S5m0yPMsqptSlMmDxM_iCaMY-ZTxl22D3GAL3fTIIy"
            />
          </div>
          <div class="p-4 border-t border-outline-variant bg-surface-container-lowest flex-1">
            <p class="font-body-sm text-body-sm text-on-surface">Ferruccio Lamborghini with 350 GT prototype in Sant'Agata, 1964.</p>
            <p class="font-label-mono-sm text-label-mono-sm text-outline mt-2 uppercase">
              Bizzarrini quad-cam 3.5L 60-degree V12 powerhouse.
            </p>
          </div>
        </Card>

        <!-- Vertical Timeline Card -->
        <Card className="bg-surface-container-low p-6 flex flex-col justify-between rounded-none">
          <div>
            <div class="font-label-mono-sm text-label-mono-sm text-outline uppercase tracking-wider pb-3 border-b border-outline-variant mb-4">
              HISTORICAL LINEAGE // RADICAL CHASSIS
            </div>
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <span class="font-label-mono-md text-label-mono-md text-[#C7D500] font-mono shrink-0">1963</span>
                <div>
                  <h4 class="font-body-sm font-semibold text-primary">Automobili Lamborghini</h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Factory erected from pristine soil in Sant'Agata Bolognese.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="font-label-mono-md text-label-mono-md text-[#C7D500] font-mono shrink-0">1964</span>
                <div>
                  <h4 class="font-body-sm font-semibold text-primary">350 GT Debut</h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Carrozzeria Touring Superleggera body over Bizzarrini V12.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="font-label-mono-md text-label-mono-md text-[#C7D500] font-mono shrink-0">1966</span>
                <div>
                  <h4 class="font-body-sm font-semibold text-primary">The Miura Reshapes</h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Dallara and Stanzani engineer the transverse mid-engine revolution.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="font-label-mono-md text-label-mono-md text-[#C7D500] font-mono shrink-0">1974</span>
                <div>
                  <h4 class="font-body-sm font-semibold text-primary">Countach LP400</h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Marcello Gandini scissor doors and geometric wedge profile enter production.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="pt-4 border-t border-outline-variant font-label-mono-sm text-label-mono-sm text-outline mt-6">
            V12 POWERTRAIN CONTINUITY // 61 YEARS
          </div>
        </Card>
      </div>
    </div>

    <!-- Flagship Spec Table -->
    <div class="border border-outline-variant bg-surface-container-low p-6 md:p-8 mb-space-xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
        <div class="lg:col-span-5">
          <span class="font-label-mono-sm text-label-mono-sm text-[#C7D500] uppercase tracking-wider block mb-1">
            FLAGSHIP TECHNICAL DOSSIER
          </span>
          <h3 class="font-headline-xl text-headline-xl uppercase text-primary">REVUELTO</h3>
          <p class="font-body-md text-body-md text-on-surface-variant mt-4">
            The first V12 plug-in hybrid from the brand, dramatic in shape and loud about it.
          </p>
          <div class="mt-6 font-label-mono-sm text-label-mono-sm text-outline space-y-1">
            <div>ASSEMBLY: LINEA REVUELTO, SANT'AGATA BOLOGNESE</div>
            <div>HOMOLOGATION: HPEV (HIGH PERFORMANCE ELECTRIFIED VEHICLE)</div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>PARAMETER</TableHead>
                <TableHead className="text-right">MEASURED VALUE</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              <TableRow className="bg-surface hover:bg-surface-container">
                <TableCell className="font-body-sm text-on-surface">Engine</TableCell>
                <TableCell className="font-label-mono-md text-label-mono-md text-primary text-right font-mono">
                  6.5L V12 + 3 electric motors
                </TableCell>
              </TableRow>
              <TableRow className="bg-surface hover:bg-surface-container">
                <TableCell className="font-body-sm text-on-surface">Power</TableCell>
                <TableCell className="font-label-mono-md text-label-mono-md text-primary text-right font-mono">
                  1,015 PS
                </TableCell>
              </TableRow>
              <TableRow className="bg-surface hover:bg-surface-container">
                <TableCell className="font-body-sm text-on-surface">0-100 km/h</TableCell>
                <TableCell className="font-label-mono-md text-label-mono-md text-primary text-right font-mono">
                  2.5 s
                </TableCell>
              </TableRow>
              <TableRow className="bg-surface hover:bg-surface-container">
                <TableCell className="font-body-sm text-on-surface">Top speed</TableCell>
                <TableCell className="font-label-mono-md text-label-mono-md text-primary text-right font-mono">
                  350+ km/h
                </TableCell>
              </TableRow>
              <TableRow className="bg-surface hover:bg-surface-container">
                <TableCell className="font-body-sm text-on-surface">Drive</TableCell>
                <TableCell className="font-label-mono-md text-label-mono-md text-primary text-right font-mono">
                  AWD
                </TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </div>
      </div>
    </div>

    <!-- Gallery Strip (3 In Row) -->
    <div>
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-outline-variant">
        <span class="font-label-mono-sm text-label-mono-sm text-outline uppercase tracking-wider">
          MECHANICAL PLATES // DETAIL INSPECTION
        </span>
        <span class="font-label-mono-sm text-label-mono-sm text-[#C7D500] uppercase">
          3 ARCHIVAL APERTURES
        </span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        <Card className="bg-surface-container-lowest overflow-hidden group rounded-none">
          <div class="h-64 overflow-hidden relative">
            <img
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
              alt="Technical top-down close up photograph of naturally aspirated 6.5 liter Lamborghini V12 engine bay"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuB4OSNaQM1NPuFYx8rJfpfNdR1GpXiGigoctKuh0kuvA-DqyaRDqybaAtuzoRVn8kcT_Kma8kJNtBfVBBLqf3nOsrctxmMHZF_IkuggQVapK5Ng-3zx_Vz64NdO_Z6h-JE9Qbti1F6xzPeoj-ARl798dATwvyZNW7c9Gg3vZyFTJnLi9mBZNozHrLlhR5fegUOwFvQFNLzmatULeuOQFhKVusNLHESuJ2etTx2UFz-iz8cfRy5UAsOH"
            />
          </div>
          <div class="p-3 border-t border-outline-variant font-label-mono-sm text-label-mono-sm">
            <span class="text-primary block uppercase">PL-07 // L545 6.5L V12</span>
            <span class="text-outline">Rotated 180 degrees with 9,500 RPM rev limit.</span>
          </div>
        </Card>

        <Card className="bg-surface-container-lowest overflow-hidden group rounded-none">
          <div class="h-64 overflow-hidden relative">
            <img
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
              alt="Interior cockpit photograph of Lamborghini Revuelto"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-kxnPTWKhMD8d6j3qMvW3bmwpeGx6SoranTc3MxqHOENmcd6_kpmupnrmakzlm1lAywjonUFov9Ap4yDzt5Vwi8YEUijtKGc2-6p0jKN6vTcdDcLl-peEQFASTXJDFjG_3vN_-Gt-jvQa_oEgZpm-xcMs3MHYl_ZXfgsumwiuTjgD6uxbFbk8BgbjqDczY4XpZ1aPdj17OvY9stCbOtU7VpylE9KbMXKTp1XVQ2LtuwzLSbv1ixU_9frLAc9bLfQzbw"
            />
          </div>
          <div class="p-3 border-t border-outline-variant font-label-mono-sm text-label-mono-sm">
            <span class="text-primary block uppercase">PL-08 // Y-DESIGN INTERFACE</span>
            <span class="text-outline">Aviation-inspired pilot cockpit and digital command dials.</span>
          </div>
        </Card>

        <Card className="bg-surface-container-lowest overflow-hidden group rounded-none">
          <div class="h-64 overflow-hidden relative">
            <img
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
              alt="Motion photograph of bright acid green Lamborghini Revuelto sliding around wet hairpin bend"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBGxxt9xlhWpqECwYk_1viRnU_rLz5L7DhQbfv6Z48RUmIBFiZzijtErlLtqAm8nHUn7-bSDanCelpwnIbD_uLPW8w6T9SB4XdWh99hQuV85O3BXijsXFeB5pCvx9rAeX_IcCSphQEpNmsr53ZSEy0qmIJl3zXPu6C_5kPuTG44jePriGGCeKc04CcdTKRXMEGKrem-eQTi2OaYeMb47Vs4t4npOq_6lvLvw1NWadYq9e5vwbHuTQPJORjBT2mzYGn9qG7Hno_eLjDXLw"
            />
          </div>
          <div class="p-3 border-t border-outline-variant font-label-mono-sm text-label-mono-sm">
            <span class="text-primary block uppercase">PL-09 // TORQUE VECTORING AWD</span>
            <span class="text-outline">Twin front axial-flux motors managing wet Alpine hairpins.</span>
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>
